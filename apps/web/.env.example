# Demo-only "Preview state" controls on each page.
NEXT_PUBLIC_DEMO_MODE=true
# "mock" (default): simulated sign-in (any email, password "demo").
# "api": real email + password sign-in against the API (accounts: npm run user:create -w apps/api).
NEXT_PUBLIC_DATA_SOURCE=mock
# Server-side only: where Next proxies /api/v1/* (the API's HOST:PORT).
API_ORIGIN=http://127.0.0.1:4000
# next dev only: extra hosts (e.g. this PC's LAN IP) allowed to load dev resources, so a phone on the same LAN works.
# Exact host names or IPv4 addresses, comma-separated, no wildcards. Add the matching origin to the API's APP_EXTRA_ORIGINS.
# DEV_ALLOWED_HOSTS=192.168.1.10
# Remote Administration (direct ZeroTier access): the network users' own devices join. Not a secret; an
# administrator still authorizes every device in ZeroTier Central. Leave empty to show "ask your administrator".
NEXT_PUBLIC_ZT_NETWORK_ID=
# Remote Administration path: "disabled" (default, including missing/invalid values) = no web access;
# "direct" = users' own ZeroTier + the setup wizard; "gateway" = one-time API tickets to the ZeroTier gateway.
# Staging with disabled mode also requires REMOTE_GATEWAY_ENABLED=false on the API.
NEXT_PUBLIC_REMOTE_MODE=disabled
# Required for gateway mode: exact public HTTPS origin used by REMOTE_GATEWAY_ORIGIN on the API.
# NEXT_PUBLIC_GATEWAY_ORIGIN=https://gateway.example.com
