        "filters": {
          "conditions": [
            {
              "keyName": "event_id",
              "condition": "eq",
              "keyValue": "={{ $('Webhook').item.json.headers['x-pisowifi-event-id'] }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "5c1e7a20-9b3d-4e61-8f02-000000000003",
      "name": "Load Delivery State",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        200
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "plan",
              "type": "object",
              "value": "={{ (() => { const STALE_MS = 120000; const now = Date.now(); const st = {}; for (const i of $('Load Delivery State').all()) { const r = i.json; if (r && r.recipient_id) st[r.recipient_id] = r; } const all = $('Webhook').first().json.body.recipients; const toSend = []; let alreadySent = 0, inFlight = 0; for (const x of all) { const r = st[x.id]; if (r && r.status === 'sent') { alreadySent++; continue; } if (r && r.status === 'sending' && now - Date.parse(r.attempted_at) < STALE_MS) { inFlight++; continue; } toSend.push({ recipientId: x.id, email: x.email }); } return { total: all.length, alreadySent, inFlight, toSend }; })() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "5c1e7a20-9b3d-4e61-8f02-000000000004",
      "name": "Plan",
