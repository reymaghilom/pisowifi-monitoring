        "emailType": "text",
        "message": "={{ (() => { const b = $('Webhook').first().json.body; const n = String(b.machine.name).replace(/[\\r\\n\\t]+/g, ' ').trim(); const down = b.event === 'machine.unreachable'; return [down ? n + ' is Offline.' : n + ' is Back Online.', '', 'Machine: ' + n, 'IP: ' + String(b.machine.ip), 'Status: ' + (down ? 'Offline' : 'Back Online'), 'Detected: ' + b.detectedDate + ', ' + b.detectedTime + ' (Asia/Manila, UTC+8)', '', 'Event ID: ' + b.eventId].join('\\n'); })() }}",
