            {
              "id": "a0",
              "name": "plan",
              "type": "object",
              "value": "={{ (() => { const EXPECTED_MACHINES = 2; const EXPECTED_RECIPIENTS = 3; const STALE_MS = 120000; const b = $('Webhook').first().json.body; const rows = (n) => $(n).all().map((i) => i.json).filter((r) => r && typeof r === 'object' && Object.keys(r).length > 0); const norm = (v) => String(v ?? '').trim().toLowerCase(); const machines = rows('Load Approved Machines').map((r) => norm(r.machine_id)).filter((v) => v !== ''); const people = rows('Load Approved Recipients').map((r) => norm(r.user_id)).filter((v) => v !== ''); const out = { decision: 'send', total: b.recipients.length, approved: 0, notApproved: 0, alreadySent: 0, inFlight: 0, toSend: [] }; if (machines.length !== EXPECTED_MACHINES || new Set(machines).size !== EXPECTED_MACHINES || people.length !== EXPECTED_RECIPIENTS || new Set(people).size !== EXPECTED_RECIPIENTS) return { ...out, decision: 'config_error' }; if (!machines.includes(norm(b.machine.id))) return { ...out, decision: 'machine_not_approved' }; const at = Date.parse(b.detectedAt); if (rows('Load Machine History').some((r) => r.status === 'sent' && r.event_id !== b.eventId && Date.parse(String(r.detected_at)) > at)) return { ...out, decision: 'superseded' }; const now = Date.now(); const st = {}; for (const r of rows('Load Delivery State')) { if (!r.recipient_id) continue; const s = st[r.recipient_id] ?? (st[r.recipient_id] = { sent: false, live: false }); if (r.status === 'sent') s.sent = true; if (r.status === 'sending' && now - Date.parse(String(r.attempted_at)) < STALE_MS) s.live = true; } for (const x of b.recipients) { if (!people.includes(norm(x.id))) { out.notApproved++; continue; } out.approved++; const s = st[x.id]; if (s && s.sent) { out.alreadySent++; continue; } if (s && s.live) { out.inFlight++; continue; } out.toSend.push({ recipientId: x.id, email: x.email }); } if (out.approved === 0) out.decision = 'no_approved_recipients'; else if (out.toSend.length === 0) out.decision = 'nothing'; return { ...out, staleMs: STALE_MS }; })() }}"
