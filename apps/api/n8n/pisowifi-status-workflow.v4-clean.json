 = b.downtimeSeconds; const o = DateTime.fromISO(String(b.outageStartedAt), { zone: 'utc' }); if (b.event !== 'machine.reachable' || !Number.isInteger(s) || s < 0 || !o.isValid || Math.abs(Math.floor((at.toMillis() - o.toMillis()) / 1000) - s) > 1) return no('downtime'); } const r = b.recipients; if (!Array.isArray(r) || r.length < 1 || r.length > 20) return no('recipients'); const seen = new Set(); for (const x of r) { if (!x || typeof x !== 'object' || !UUID.test(String(x.id ?? '')) || seen.has(x.id)) return no('recipients'); seen.add(x.id); const e = String(x.email ?? ''); if (e.length > 254 || !/^[^@\\s,;<>\"'()\\[\\]]+@[^@\\s,;<>\"'()\\[\\]]+[.][^@\\s,;<>\"'()\\[\\]]+$/.test(e)) return no('recipients'); } return { ok: true, reason: '' }; })() }}"
