# PisoWiFi Monitoring API and worker. Copy to .env (never commit .env).

# --- Used now (milestone B0) ---
NODE_ENV=development
# Keep 127.0.0.1 on the VPS: the reverse proxy is the only public entry point.
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# --- Database ---
# Runtime connection (API + worker) as the least-privilege role pisowifi_app.
#   Local Docker/PostgreSQL: postgresql://pisowifi_app:<password>@127.0.0.1:5432/pisowifi
#   Supabase (transaction pooler, port 6543):
#   postgresql://pisowifi_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://pisowifi:change-me@127.0.0.1:5432/pisowifi
# Migrations and role provisioning only (schema owner). Falls back to DATABASE_URL when unset.
#   Supabase (session pooler, port 5432; the direct connection is IPv6-only):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# MIGRATION_DATABASE_URL=
# TLS: "verify" (certificate checked against DATABASE_SSL_CA) or "off" (allowed only for localhost).
# Default: verify in production, off otherwise. Don't put sslmode in the URLs; they are rejected.
DATABASE_SSL=off
# PEM CA certificate path (Supabase: Project Settings → Database → SSL Configuration → Download certificate)
# DATABASE_SSL_CA=./certs/supabase-prod-ca.crt
# Connections per process (API and worker each have their own pool)
DATABASE_POOL_MAX=5
# Connect timeout per pool connection (TCP + TLS + SCRAM through the Supabase pooler can take 5-10 s on a slow link)
DATABASE_CONNECT_TIMEOUT_MS=20000
# Worker: raw checks older than this many days are deleted hourly; status changes and outages are kept
CHECK_RETENTION_DAYS=90
# Only for `npm run db:provision-app-role` (hashed locally, never sent or printed). Remove after use.
# APP_DB_PASSWORD=
# true only when Caddy connects directly to this API at 127.0.0.1; trusts one loopback hop.
# Caddy must replace client-supplied forwarding headers and send the real client IP last.
TRUST_PROXY=false
# Exact web origin for CSRF. Production requires https and HOST=127.0.0.1.
APP_ORIGIN=http://localhost:3000
# Optional: other exact origins of the same web app that pass the Origin check, comma-separated, no wildcards.
# Development from a phone on the same LAN: http://<PC LAN IP>:3000 (and DEV_ALLOWED_HOSTS in apps/web/.env.local).
# APP_EXTRA_ORIGINS=http://192.168.1.10:3000
# Session cookie Secure flag + __Host- prefix. Default: true in production (required there).
# Set false only for local development over plain http.
SESSION_COOKIE_SECURE=false
# Sign-in attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# --- Email (password reset, security notices), any SMTP provider ---
# Nothing is sent unless SMTP_ENABLED=true (explicit approval). Test with: npm run mail:test -- --to you@example.com
SMTP_ENABLED=false
# SMTP_HOST=
# 587 = STARTTLS (required), 465 = implicit TLS (SMTP_SECURE defaults to true for 465)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PisoWiFi Monitoring <no-reply@example.com>"

# --- ZeroTier gateway checks (Phases Z1, PC2): this API host checks machines' admin pages (remote admin is direct) ---
# Off unless true: nothing is ever sent to a machine while disabled.
GATEWAY_ENABLED=false
# GATEWAY_MODE=direct
# Required when enabled: only machine IPs inside these ranges are ever contacted
# ZT_ALLOWED_CIDRS=192.168.194.0/24
# WiFi5Soft admin port on every machine
# GATEWAY_TARGET_PORT=80
# GATEWAY_TIMEOUT_MS=5000
# GATEWAY_MAX_CONCURRENCY=4
# Optional gateway node health from the local ZeroTier service (read-only; token never logged)
# Linux: /var/lib/zerotier-one/authtoken.secret; Windows: C:/Users/<you>/AppData/Local/ZeroTier/authtoken.secret
# ZT_AUTHTOKEN_FILE=/var/lib/zerotier-one/authtoken.secret
# ZT_NETWORK_ID=<16 hex>
# ZT_LOCAL_API_URL=http://127.0.0.1:9993

# Dedicated worker only: needs GATEWAY_ENABLED, ZT_AUTHTOKEN_FILE, ZT_NETWORK_ID and DATABASE_URL.
# The API ignores this switch. Keep REMOTE_GATEWAY_ENABLED=false in the worker; it needs no ticket key.
MONITOR_SCHEDULE_ENABLED=false

# --- Status-change notifications: n8n webhook -> Gmail (see README) ---
# Off unless true. Only Reachable <-> Unreachable changes recorded by the backend are sent.
N8N_ENABLED=false
# n8n Webhook node production URL (https). SECRET: keep it out of git.
# N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/pisowifi-status
# Shared secret (>= 32 chars), same value as the n8n Header Auth credential ("Bearer <secret>"). SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# N8N_WEBHOOK_SECRET=
# Or read it from a file (production: a systemd credential, e.g. N8N_WEBHOOK_SECRET_FILE=%d/n8n-webhook-secret). Not both.
# N8N_WEBHOOK_SECRET_FILE=
# N8N_TIMEOUT_MS=10000
# N8N_MAX_ATTEMPTS=12

# --- Remote admin through the ZeroTier gateway (Azure VM, repo pisowifi-zerotier-gateway) ---
# Off unless true. The API only signs short-lived, single-use Ed25519 entry tickets; it never carries admin traffic.
REMOTE_GATEWAY_ENABLED=false
# The gateway's public origin, exactly its GATEWAY_PUBLIC_ORIGIN (the ticket audience). https.
# REMOTE_GATEWAY_ORIGIN=https://pisowifi-gw.eastasia.cloudapp.azure.com
# Ed25519 private key (PEM) from the gateway repo's `npm run keygen`. SECRET: keep it OUTSIDE this repository,
# readable only by the account running the API. Only the public key goes to the gateway VM.
# REMOTE_TICKET_PRIVATE_KEY_FILE=C:/Users/<you>/.pisowifi/ticket-private.pem
# Ticket lifetime in seconds (10-120; the gateway refuses longer tickets).
# REMOTE_TICKET_TTL_S=60
# Tickets name the machine's ZeroTier IP; it must be inside ZT_ALLOWED_CIDRS (required when enabled, same ranges
# as the gateway) and not in this list. Keep it identical to the gateway's ZT_DENY_IPS: its own ZeroTier IP and
# every member that is not a PisoWiFi machine (admin PCs, servers, phones).
# REMOTE_GATEWAY_DENY_IPS=192.168.194.104,192.168.194.22

# --- Planned, optional, not read yet ---
# ZeroTier Central API token (later; stored encrypted)
# ZT_API_TOKEN=
# 32-byte key for encrypting integration tokens (ZeroTier, n8n), base64
# ENCRYPTION_KEY=
