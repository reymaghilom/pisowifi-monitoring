{
  "name": "@pisowifi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PisoWiFi Monitoring backend: API (with authentication) and monitoring worker",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:check": "drizzle-kit check",
    "db:provision-app-role": "tsx --env-file-if-exists=.env src/db/provision-app-role.ts",
    "user:create": "tsx --env-file-if-exists=.env src/auth/cli.ts create",
    "user:set-password": "tsx --env-file-if-exists=.env src/auth/cli.ts set-password",
    "user:list": "tsx --env-file-if-exists=.env src/auth/cli.ts list",
    "mail:test": "tsx --env-file-if-exists=.env src/mail/cli.ts",
    "gateway:check": "tsx --env-file-if-exists=.env src/gateway/cli.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@pisowifi/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  }
}
