{
  "name": "@pisowifi/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types and Zod validation for the PisoWiFi Monitoring web app and API",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  }
}
